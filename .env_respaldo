# Copie este archivo: cp .env.example .env (y ajuste valores)
# NUNCA versione el archivo .env real.
# --- Docker Compose ---
COMPOSE_PROJECT_NAME=proyecto # minúsculas, sin espacios ni '<>'
# --- PostgreSQL ---
POSTGRES_DB=proyecto_db
POSTGRES_USER=proyecto_user
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_HOST=db # nombre del servicio en docker-compose
POSTGRES_PORT=5432
DB_PORT_HOST=5432 # puerto publicado en el host (cámbielo si está ocupado)
# --- Django ---
DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Orígenes del frontend permitidos por CORS (Vite 5173, Next 3000, Angular 4200)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4200